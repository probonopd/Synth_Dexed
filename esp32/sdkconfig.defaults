# FMRack ESP32-S3 SDK Configuration Defaults
#
# Optimized for ESP32-S3-DevKitC-1-N8R8 (dual-core Xtensa LX7, 8 MB PSRAM)
#

# Flash (8 MB, QIO 80 MHz)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Keep I2S ISR in IRAM to reduce crackles caused by flash/cache stalls
CONFIG_I2S_ISR_IRAM_SAFE=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# PSRAM (8 MB Octal SPI - N8R8 variant)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# Map .text and .rodata sections to PSRAM-backed instruction cache.
# With this enabled, the CPU fetches all code (WiFi, lwIP, Dexed, etc.)
# from PSRAM rather than Flash.  Flash (SPI0) is almost never accessed at
# runtime, so the SPI0/SPI1 bus arbiter is free for Core 1 audio data
# accesses — eliminating the bus-contention crackle that WiFi/Apple MIDI
# would otherwise cause.
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# Disable the brownout detector.
# The USB hub + keyboard plus I2S DMA firing together cause a transient
# voltage dip that triggers BOD and hard-resets the ESP32 right in the
# middle of USB device enumeration.  The ESP32-S3-DevKitC-1 is powered
# from a USB power bank / 5 V adapter with adequate bulk capacitance, so
# false brownout trips are more harmful than any real under-voltage event.
CONFIG_ESP_BROWNOUT_DET=n

# Allow tasks to have stacks in PSRAM
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# CPU Frequency (240 MHz, dual-core)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# FreeRTOS - dual-core
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_FREERTOS_UNICORE=n

# Compiler optimization
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y

# C++ exceptions (needed by Dexed engine)
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=0

# Stack size for main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Wi-Fi for UDP MIDI
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
# Put the WiFi and lwIP hot paths in IRAM so packet handling never causes
# a flash fetch that stalls the SPI0 bus and introduces audio jitter.
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION=y

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Audio render block size (256 samples = ~5.8 ms at 44.1 kHz, balances latency & efficiency)
CONFIG_FMRACK_BUFFER_SIZE=256

# Default polyphony for Dexed engine
CONFIG_FMRACK_POLYPHONY=4

# Sample rate (higher rates give better fidelity at increased CPU cost)
CONFIG_FMRACK_SAMPLE_RATE=44100

# Choose FM engine: 0=MSFA (modern), 1=MKI (legacy), 2=OPL
CONFIG_FMRACK_ENGINE=0

# Watchdog - increase timeout for audio processing
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_INT_WDT_TIMEOUT_MS=800

# SPIFFS
CONFIG_SPIFFS_MAX_PARTITIONS=1

# Console via UART0.
# Note: USB OTG (GPIO19/20) is used in Host mode for USB-MIDI.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Disable USB Serial/JTAG peripheral to avoid conflicts with USB OTG host mode
# (GPIO19/20).
# CONFIG_USJ_ENABLE_USB_SERIAL_JTAG is not set

# USB Host — enable external hub support so keyboards attached
# through a hub are enumerated and recognised.
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# USB Host FIFO bias: maximise periodic (isochronous/interrupt) OUT bandwidth.
# Default BALANCED gives only 128-byte periodic TX FIFO, which is too small for
# USB audio isochronous OUT at 44100 Hz stereo 16-bit (MPS=200 bytes).
# PERIODIC_OUT reconfigures: ptx_fifo = fifo_size-50 lines (~824 bytes) so
# MPS=200 fits.  Trade-off: IN max=136 bytes (MIDI bulk IN MPS=64 OK), non-
# periodic OUT max=64 bytes (EP0 control transfers OK).
CONFIG_USB_HOST_HW_BUFFER_BIAS_PERIODIC_OUT=y

# USB Host timing tweaks (improves reliability with some hubs/keyboards)
CONFIG_USB_HOST_DEBOUNCE_DELAY_MS=500
CONFIG_USB_HOST_RESET_RECOVERY_MS=100
CONFIG_USB_HOST_SET_ADDR_RECOVERY_MS=50
CONFIG_USB_HOST_EXT_PORT_RESET_RECOVERY_DELAY_MS=100
CONFIG_USB_HOST_EXT_PORT_CUSTOM_POWER_ON_DELAY_ENABLE=y
CONFIG_USB_HOST_EXT_PORT_CUSTOM_POWER_ON_DELAY_MS=500

# Newlib
CONFIG_NEWLIB_STDOUT_LINE_BUFFERING=y

# Heap
CONFIG_HEAP_POISONING_DISABLED=y
